generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ─────────────────────────────────────────────────────────────────────────────
// Identity
//   Roles: `host` = agent (property lister), `guest` = seeker, `admin` = platform.
//   (Enum values kept from the fork for now; renamed to seeker/agent in the auth
//   adaptation step.)
// ─────────────────────────────────────────────────────────────────────────────
model User {
  id              String     @id @default(cuid())
  email           String?    @unique
  phone           String?    @unique
  phoneVerified   Boolean    @default(false)
  passwordHash    String?
  firstName       String
  lastName        String
  avatarUrl       String?
  role            UserRole   @default(seeker)
  status          UserStatus @default(active)
  preferredLocale String     @default("en")
  fcmToken        String?
  businessName    String? // agency / brokerage name
  bio             String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  auditLogs              AdminAuditLog[]
  listings               Listing[]
  notifications          Notification[]
  refreshTokens          RefreshToken[]
  messages               Message[]
  chatMemberships        ChatMember[]
  deviceTokens           DeviceToken[]
  wishlists              Wishlist[]
  notificationPreference NotificationPreference?
  savedSearches          SavedSearch[]
  leads                  Lead[]                  @relation("AgentLeads")
  submittedLeads         Lead[]                  @relation("SeekerLeads")

  @@index([email])
  @@index([phone])
  @@index([role])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Taxonomy
// ─────────────────────────────────────────────────────────────────────────────
model Category {
  id           String        @id @default(cuid())
  name         String        @unique
  slug         String        @unique
  iconUrl      String?
  listings     Listing[]
  listingTypes ListingType[]

  @@index([slug])
}

model City {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  imageUrl  String?
  tags      String[] @default([])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([isActive])
}

model Tag {
  id       String       @id @default(cuid())
  name     String       @unique
  slug     String       @unique
  listings ListingTag[]
}

/// Property type (house, apartment, condo, …). `fields` holds an optional
/// per-type custom-attribute schema for type-specific listing details.
model ListingType {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  iconUrl     String?
  description String?
  fields      Json?
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  listings    Listing[]

  @@index([slug])
  @@index([categoryId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Listings (real-estate)
//   Geo: latitude/longitude are the source coordinates. A PostGIS `geom` column
//   + GiST index + search_listings() are added by a raw SQL migration and
//   queried via $queryRaw (SearchEngine seam). See legacy-sql/.
// ─────────────────────────────────────────────────────────────────────────────
model Listing {
  id               String        @id @default(cuid())
  hostId           String // owner (agent)
  categoryId       String?
  type             String // property type -> ListingType.name
  tenure           Tenure
  status           ListingStatus @default(draft)
  title            String
  description      String
  slug             String        @unique
  priceAmount      Decimal       @db.Decimal(14, 2)
  priceCurrency    String        @default("USD")
  rentPeriod       RentPeriod? // required when tenure = rent (enforced in service)
  bedrooms         Int?
  bathrooms        Decimal?      @db.Decimal(3, 1)
  areaSqft         Decimal?      @db.Decimal(10, 1)
  lotSqft          Decimal?      @db.Decimal(12, 1)
  yearBuilt        Int?
  locationName     String? // neighborhood / area label
  address          String?
  city             String
  region           String?
  postalCode       String?
  country          String        @default("US")
  latitude         Decimal?      @db.Decimal(9, 6)
  longitude        Decimal?      @db.Decimal(9, 6)
  images           String[]
  featuredAt       DateTime?
  featuredUntil    DateTime?
  isFeatured       Boolean       @default(false)
  averageRating    Decimal?      @db.Decimal(3, 2)
  reviewCount      Int           @default(0)
  viewCount        Int           @default(0)
  rejectionNote    String?
  metadata         Json?
  requiresApproval Boolean       @default(false)
  publishedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  category     Category?    @relation(fields: [categoryId], references: [id])
  host         User         @relation(fields: [hostId], references: [id])
  listingType  ListingType? @relation(fields: [type], references: [name])
  tags         ListingTag[]
  chatRooms    ChatRoom[]
  wishlistedBy Wishlist[]
  leads        Lead[]

  @@index([hostId])
  @@index([type])
  @@index([tenure])
  @@index([status])
  @@index([city])
  @@index([slug])
  @@index([isFeatured])
  @@index([priceAmount])
  @@index([bedrooms])
}

model ListingTag {
  listingId String
  tagId     String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([listingId, tagId])
}

model Wishlist {
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([userId, listingId])
  @@index([userId])
  @@index([listingId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Leads (F4) — seeker → agent enquiries, contact requests, viewing requests.
//   A lead is written transactionally on submit, then delivered to the listing's
//   agent (in-app notification + queued email with retry). `seekerId` is set when
//   the submitter is a signed-in seeker; anonymous enquiries leave it null.
// ─────────────────────────────────────────────────────────────────────────────
model Lead {
  id          String     @id @default(cuid())
  listingId   String
  agentId     String // denormalised listing.hostId — the recipient (fast inbox queries)
  seekerId    String? // set when submitted by a signed-in seeker
  kind        LeadKind   @default(enquiry)
  status      LeadStatus @default(new)
  name        String
  email       String
  phone       String?
  message     String
  preferredAt DateTime? // requested viewing date/time (kind = viewing_request)
  source      String     @default("web")
  ipAddress   String?
  deliveredAt DateTime? // email delivery timestamp (set by the delivery worker)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  agent   User    @relation("AgentLeads", fields: [agentId], references: [id], onDelete: Cascade)
  seeker  User?   @relation("SeekerLeads", fields: [seekerId], references: [id], onDelete: SetNull)

  @@index([agentId, status])
  @@index([listingId])
  @@index([seekerId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Saved searches + alerts (F5) — persisted search criteria with optional email
//   alerts. A scheduled matcher runs new published listings against each saved
//   search since `lastCheckedAt` and emails digests to the owner.
// ─────────────────────────────────────────────────────────────────────────────
model SavedSearch {
  id             String         @id @default(cuid())
  userId         String
  name           String
  /// Canonical search params (tenure, city, priceMin/Max, minBeds, …) as stored
  /// on the URL. Matched against new listings by the alert matcher.
  query          Json
  notify         Boolean        @default(true)
  frequency      AlertFrequency @default(instant)
  lastCheckedAt  DateTime       @default(now()) // watermark: only listings created after this are considered
  lastNotifiedAt DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([notify])
}

// ─────────────────────────────────────────────────────────────────────────────
// Messaging (agent ↔ seeker) — lead threads
// ─────────────────────────────────────────────────────────────────────────────
model ChatRoom {
  id        String       @id @default(cuid())
  listingId String?
  date      DateTime?    @db.Date
  type      ChatType     @default(group)
  name      String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  listing   Listing?     @relation(fields: [listingId], references: [id])
  messages  Message[]
  members   ChatMember[]

  @@index([listingId])
}

model ChatMember {
  id       String   @id @default(cuid())
  roomId   String
  userId   String
  role     String   @default("member")
  joinedAt DateTime @default(now())
  room     ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
}

model Message {
  id        String   @id @default(cuid())
  roomId    String
  senderId  String
  text      String
  mediaUrl  String?
  type      String   @default("text")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  room      ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender    User     @relation(fields: [senderId], references: [id])

  @@index([roomId])
  @@index([senderId])
}

enum ChatType {
  direct
  group
  listing_public
}

// ─────────────────────────────────────────────────────────────────────────────
// Notifications
// ─────────────────────────────────────────────────────────────────────────────
model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([readAt])
}

model NotificationPreference {
  id             String   @id @default(cuid())
  userId         String   @unique
  pushEnabled    Boolean  @default(true)
  smsEnabled     Boolean  @default(true)
  inAppEnabled   Boolean  @default(true)
  // Category switches (kept from the fork; some are unused in v1 but the
  // notifications module maps every NotificationType onto one of these).
  bookingUpdates Boolean  @default(true)
  paymentUpdates Boolean  @default(true)
  listingUpdates Boolean  @default(true)
  disputeUpdates Boolean  @default(true)
  payoutUpdates  Boolean  @default(true)
  messages       Boolean  @default(true)
  promotions     Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SmsLog {
  id               String      @id @default(cuid())
  recipient        String
  content          String
  category         SmsCategory @default(transactional)
  status           SmsStatus   @default(sent)
  provider         String      @default("textify")
  providerResponse Json?
  errorMessage     String?
  segments         Int         @default(1)
  userId           String?
  createdAt        DateTime    @default(now())

  @@index([recipient])
  @@index([category])
  @@index([status])
  @@index([createdAt])
  @@index([userId])
}

model SmsOptOut {
  phone     String   @id
  reason    String?
  createdAt DateTime @default(now())
}

enum SmsCategory {
  otp
  transactional
  notification
  broadcast
}

enum SmsStatus {
  sent
  failed
  delivered
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  targetType String
  targetId   String
  meta       Json?
  createdAt  DateTime @default(now())
  admin      User     @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([targetType, targetId])
  @@index([action])
}

model DeviceToken {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  platform   String
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────
enum UserRole {
  seeker
  agent
  admin
}

enum UserStatus {
  active
  suspended
  banned
}

enum Tenure {
  sale
  rent
}

enum RentPeriod {
  week
  month
  year
}

enum ListingStatus {
  draft
  published
  under_offer
  sold
  let
  withdrawn
}

enum LeadKind {
  enquiry
  contact
  viewing_request
}

enum LeadStatus {
  new
  contacted
  qualified
  closed
}

enum AlertFrequency {
  instant
  daily
}

enum NotificationType {
  booking_confirmed
  booking_cancelled
  booking_pending_approval
  payment_received
  payment_failed
  payment_expired
  listing_approved
  listing_rejected
  new_review
  payout_processed
  payout_failed
  dispute_raised
  dispute_response
  dispute_resolved
  new_message
  kyc_approved
  kyc_rejected
  otp
  broadcast
  waitlist_spot_available
  ticket_transferred
  earnings_available
  listing_boosted
  new_lead
  saved_search_match
}
