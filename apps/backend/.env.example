# ── Core (required) ──────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000

# Postgres (Neon or self-hosted). PostGIS must be enabled.
DATABASE_URL=postgresql://user:password@localhost:5432/homes?schema=public
DATABASE_URL_UNPOOLED=postgresql://user:password@localhost:5432/homes?schema=public

# Redis / Valkey (queues + socket.io adapter)
REDIS_URL=redis://localhost:6379

# JWT secrets — must be at least 32 chars each (generate with `openssl rand -hex 32`)
JWT_ACCESS_SECRET=replace-with-a-32+-char-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-32+-char-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── Email (lead delivery + auth codes) ───────────────────────────────────────
# Get a key at https://resend.com. Unset = emails are skipped (no-op) in dev.
RESEND_API_KEY=re_your_resend_api_key_here
MAIL_FROM=Homes <noreply@example.com>
# Public web origin — used to build listing/dashboard links in lead + alert emails.
WEB_APP_URL=http://localhost:3000

# ── Media (listing images) ───────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Optional ─────────────────────────────────────────────────────────────────
SENTRY_DSN=
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=
ALLOWED_ORIGINS=http://localhost:3000
