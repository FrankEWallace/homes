# Web app (apps/web) environment.
# The web talks only to the backend API — no direct DB/provider access.
# For the backend's own env, see apps/backend/.env.example.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base URL of the backend API (include the /api/v1 prefix).
API_BASE_URL=http://localhost:4000/api/v1
